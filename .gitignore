# Dependencias
node_modules/

# Entornos y secretos
#
# El patrón es "todo .env queda fuera, salvo los ejemplos" y no una lista de
# variantes conocidas: un respaldo tipo `.env.test.respaldo` no coincidía con
# la lista vieja y aparecía como archivo sin trackear, a un "stage all" de
# distancia de subir credenciales al repo.
.env
.env.*
!.env.example
!.env.test.example

# Imágenes subidas por usuarios (dev local)
/backend/uploads/

# Builds
/frontend/build/
/mobile/android/
/mobile/ios/

# Estado local de `wrangler dev` (ciclo 7B): caché simulada de Workers/D1/KV,
# nada que versionar
/frontend/.wrangler/

# Salida de las pruebas E2E (Playwright) — se regenera en cada corrida
/e2e/test-results/
/e2e/playwright-report/

# Salidas generadas de las herramientas del avatar: ambas se reconstruyen del
# catálogo vivo, así que versionarlas sería guardar copias que envejecen solas
/backend/scripts/avatar-hoja.html
/backend/scripts/plantillas-wt2/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores y SO
.vscode/
.DS_Store
Thumbs.db

# Instrucciones personales de Claude (no versionar)
CLAUDE.md

# Planeacion, analisis y prompts de trabajo (no versionar)
.planeacion/

# Salida de graphify: cache regenerable + rutas absolutas de la maquina local
# (.graphify_python, .graphify_root) que no tiene sentido versionar
graphify-out/
