{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weedtown",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true
  },
  // "main" convierte esto de "solo assets" a Worker con binding de assets
  // (HU-SHR-002, ciclo 7B). NO LO QUITES sin leer src/worker.js primero: sin
  // este archivo, weedtown.social sigue sirviendo el SPA para todo, pero
  // /p/:id deja de tener meta tags Open Graph — un enlace pegado en WhatsApp,
  // Telegram, Facebook o X vuelve a verse como texto plano, SIN QUE NADA
  // FALLE NI AVISE (T7 del plan: ese silencio es la trampa). El resto de
  // rutas (/feed, /login, /auth/callback, cualquier archivo estático) no
  // cambia: src/worker.js les pasa de largo a env.ASSETS.fetch(), que es
  // exactamente lo que Workers Static Assets hacía antes de que este archivo
  // existiera.
  "main": "src/worker.js",
  "assets": {
    "directory": "build",
    // Con "main" presente, el binding necesita nombre propio: el Worker lo
    // usa como env.ASSETS.fetch() para servir el index.html real que
    // src/worker.js reescribe con HTMLRewriter, y para pasar de largo todo
    // lo que no sea /p/:id.
    "binding": "ASSETS",
    // SPA fallback nativo de Workers Static Assets: cualquier ruta que no
    // coincida con un archivo real (p. ej. /auth/callback, /profile, /feed)
    // sirve index.html con 200, para que React Router la resuelva del lado
    // del cliente. El truco de "_redirects" al estilo Pages clásico (/* ->
    // /index.html) NO sirve aquí: este producto lo detecta como loop infinito
    // porque su propio manejo de rutas ya intenta strip de .html/index.
    // Se conserva íntegro: src/worker.js solo intercepta /p/:id, todo lo
    // demás sigue resolviéndose aquí, sin que el Worker le cambie nada.
    "not_found_handling": "single-page-application"
  },
  // URL del backend que consulta src/worker.js para la ficha de /p/:id
  // (GET /api/posts/:id/preview) — configurable a propósito (nunca
  // incrustada en el código, criterio 8 de HU-SHR-002).
  //
  // Este valor de arriba es el que usa `wrangler dev` (sin --env) — solo
  // para desarrollo local. A PROPÓSITO no es el valor que se despliega: si
  // `npm run deploy` lo leyera directo, el Worker en Cloudflare intentaría
  // hablarle a "localhost" desde el borde, fallaría siempre, y como el
  // diseño cae a la ficha genérica sin error (T8/T4), NADIE se enteraría —
  // mismo patrón de "variable mal puesta apaga algo en silencio" que
  // apiLimiter (ver Tarea 0 del ciclo 7B en app.js). Por eso producción vive
  // en su propio bloque `env.production` de abajo, y `npm run deploy` lo
  // pide explícitamente con `--env production` — no hay forma de desplegar
  // "por accidente" con el valor de desarrollo.
  "vars": {
    "PREVIEW_API_URL": "http://localhost:4000"
  },
  // El deploy AUTOMÁTICO (integración de Git de Cloudflare, en cada push a
  // `main`) no lee el script `deploy` de package.json — usa su propio comando,
  // guardado aparte en el dashboard: Workers & Pages > weedtown > Settings >
  // Build > Deploy command. Ese campo YA CAUSÓ UN INCIDENTE (2026-08-06/07):
  // llegó a estar sin "--env production", así que tomaba los `vars` de la
  // raíz de este archivo (localhost) en vez de los de abajo, y /p/:id sirvió
  // la ficha genérica para TODO el sitio, sin ningún error visible. Debe decir
  // exactamente `npx wrangler deploy --env production`. Detalle completo en
  // frontend/README.md → "Deploy automático (Cloudflare)".
  "env": {
    "production": {
      "vars": {
        "PREVIEW_API_URL": "https://weedtown-api.onrender.com"
      }
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
