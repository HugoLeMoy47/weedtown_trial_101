generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Rol de la cuenta. Gobierna el acceso a /api/admin: solo MOD y ADMIN.
enum UserRole {
  USER
  MOD
  ADMIN
}

model User {
  id               Int          @id @default(autoincrement())
  // Identificador público de WeedTown, elegido por la persona y único en la
  // plataforma. Antes este papel lo hacía `acct`, la dirección de Mastodon —
  // pero eso ata el identificador visible al proveedor con el que entraste, y
  // hay proveedores donde no existe (en Telegram el usuario es opcional; con
  // llave de acceso o correo no hay ninguno).
  handle           String       @unique
  displayName      String?
  email            String?      @unique
  name             String
  // Avatar en uso. Por defecto es uno generado (ver src/lib/avatar.js): la foto
  // de Mastodon puede ser la cara real de la persona, y aparece junto a su zona
  // en "Cerca". Usarla es ahora una decisión explícita, no el default.
  avatar           String?
  // La foto de la instancia, guardada aparte para poder ofrecerla como opción
  // sin que sobrescriba lo que la persona haya elegido.
  mastodonAvatar   String?
  phone            String?
  fullName         String?
  bio              String?
  age              Int?
  birthdate        DateTime?
  gender           String?
  role             UserRole     @default(USER)
  // Eliminación propia de la cuenta (HU-PRIV-001), distinta de moderar: acá el
  // dueño de los datos ejerce su derecho a que se borren los suyos, no se
  // preserva evidencia de nada. Es ANONIMIZACIÓN, no borrado de la fila: el
  // contenido público (posts, comentarios, mensajes) sigue siendo parte de
  // conversaciones de otras personas, así que se queda, pero deja de poder
  // identificar a quien lo escribió — ver src/lib/privacy.js.
  deletedAt        DateTime?
  // Suspensión temporal (HU-SEG-005): la cuenta existe y se puede leer, pero no
  // puede publicar, comentar, chatear ni mandar toques hasta la fecha.
  suspendedUntil   DateTime?
  suspendedBy      User?        @relation("Suspensiones", fields: [suspendedById], references: [id])
  suspendedById    Int?
  suspendedReason  ReportReason?
  // Función "Cerca": celda de cuadrícula ~2 km (0.02°) calculada EN el cliente
  // (nunca llegan coordenadas reales al servidor). null = no comparte. Caduca a los 7 días.
  nearbyCell       String?
  nearbyUpdatedAt  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  posts            Post[]
  comments         Comment[]
  reactions        Reaction[]
  blocksMade       Block[]      @relation("BlocksMade")
  blocksReceived   Block[]      @relation("BlocksReceived")
  reportsMade      Report[]     @relation("ReportsMade")
  reportsReceived  Report[]     @relation("ReportsAboutUser")
  reportsResolved  Report[]     @relation("ReportsResolved")
  suspensionsGiven User[]       @relation("Suspensiones")
  moderationLog    ModerationAction[] @relation("ModeratorActions")
  hiddenPosts         Post[]         @relation("PostsHidden")
  hiddenComments      Comment[]      @relation("CommentsHidden")
  hiddenForumPosts    ForumPost[]    @relation("ForumPostsHidden")
  hiddenForumComments ForumComment[] @relation("ForumCommentsHidden")
  archivedSubforums   SubForum[]     @relation("SubforumsArchived")
  identities       Identity[]
  chats            Chat[]           @relation("UserChats")
  messages         Message[]        @relation("UserMessages")
  forumPosts       ForumPost[]
  forumComments    ForumComment[]
  subforums        SubForum[]       @relation("UserSubforums")
  subforumFollows  SubForumFollow[]
  notifications    Notification[]   @relation("NotificationRecipient")
  notificationActs Notification[]   @relation("NotificationActor")
  marketItems      MarketItem[]     @relation("UserMarketItems")
  media            Media[]
  privacyActions   PrivacyAction[]

}

// Cómo entra una persona. Separar esto de `User` es lo que permite tener más de
// un método por cuenta: hasta ahora la cuenta de Mastodon *era* la cuenta, así
// que agregar un segundo proveedor era imposible sin este corte.
//
// Tener varias identidades por usuario además resuelve la recuperación: se
// puede registrar una llave de acceso y dejar un correo de respaldo.
enum AuthProvider {
  MASTODON
  PASSKEY
  EMAIL
}

model Identity {
  id          Int          @id @default(autoincrement())
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  provider    AuthProvider
  // Identificador del proveedor, ya normalizado. Para Mastodon es
  // "instancia:idDeCuenta"; para PASSKEY es el credentialId (base64url) de la
  // llave; para EMAIL es el correo en minúsculas.
  externalId  String
  // Datos de origen, informativos: de dónde vino esta identidad. No se usan
  // para identificar ni para mostrar — para eso está User.handle.
  // Se reutiliza también como etiqueta legible: en EMAIL guarda el correo (ya
  // está en externalId, pero mostrarlo no es un dato nuevo) y en PASSKEY el
  // nombre con el que se registró la llave ("Passkey de Windows Hello"...),
  // así ninguna pantalla necesita un campo aparte por proveedor.
  instance    String?
  originHandle String?
  createdAt   DateTime     @default(now())
  lastLoginAt DateTime?
  passkey     Passkey?

  @@unique([provider, externalId])
  @@index([userId])
}

// Datos de verificación WebAuthn de una llave de acceso (PASSKEY). Separado de
// Identity a propósito: es la única información que un proveedor necesita y
// que los demás no tienen sentido teniendo (clave pública, contador anti-replay).
// Vive 1 a 1 con su Identity y se borra en cascada con ella.
model Passkey {
  id           Int      @id @default(autoincrement())
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityId   Int      @unique
  publicKey    Bytes
  // Contador anti-replay que reporta el autenticador; debe crecer en cada uso.
  counter      Int      @default(0)
  transports   String?  // lista separada por comas, ej. "internal,hybrid"
  deviceType   String?  // "singleDevice" | "multiDevice" (informativo)
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Enlace mágico: token de un solo uso para entrar/darse de alta por correo.
// Vive fuera de Identity/User a propósito — antes de que se verifique no hay
// cuenta todavía, igual que MastodonApp guarda estado de infraestructura sin
// ser parte del modelo de identidad.
model MagicLink {
  id        Int       @id @default(autoincrement())
  email     String
  // Solo se guarda el hash (sha256) del token: el token en claro únicamente
  // vive en la URL que recibe la persona por correo. Si la base se filtrara,
  // no alcanzaría para iniciar sesión como nadie.
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  // Con sesión abierta, pedir un enlace mágico es "agregar este correo como
  // respaldo", no "entrar" — se guarda a qué cuenta hay que colgarlo para que
  // el callback (que puede abrirse desde otro dispositivo o rato después) lo
  // sepa sin depender de que siga esa misma sesión activa.
  addToUserId Int?

  @@index([email, createdAt])
}

// Bloqueo entre personas (HU-SEG-001).
// Se crea y se deshace solo del lado de quien bloquea, pero su EFECTO es mutuo:
// mientras exista la fila, ninguna de las dos partes ve ni puede contactar a la
// otra. Al bloqueado nunca se le informa: la API responde como si el contenido
// o la persona no existieran.
model Block {
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockerId Int
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  blockedId Int
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model MastodonApp {
  id           Int      @id @default(autoincrement())
  instance     String   @unique
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
}

model Post {
  id        Int             @id @default(autoincrement())
  author    User            @relation(fields: [authorId], references: [id])
  authorId  Int
  content   String
  image     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  hashtags  HashtagOnPost[]
  comments  Comment[]
  reactions Reaction[]
  media     Media[]
  reports   Report[]
  // Moderación: ocultar es reversible y deja rastro (quién y cuándo).
  // No hay borrado definitivo por moderación: se conserva la evidencia.
  hiddenAt     DateTime?
  hiddenBy     User?         @relation("PostsHidden", fields: [hiddenById], references: [id])
  hiddenById   Int?
  hiddenReason ReportReason?

  @@index([hiddenAt, createdAt])
}

model Hashtag {
  id    Int             @id @default(autoincrement())
  tag   String          @unique
  posts HashtagOnPost[]
}

model HashtagOnPost {
  postId    Int
  hashtagId Int
  post      Post    @relation(fields: [postId], references: [id])
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])
  @@id([postId, hashtagId])
}

model Comment {
  id        Int        @id @default(autoincrement())
  content   String
  image     String?
  post      Post       @relation(fields: [postId], references: [id])
  postId    Int
  author    User       @relation(fields: [authorId], references: [id])
  authorId  Int
  reactions Reaction[]
  reports   Report[]
  createdAt DateTime   @default(now())
  hiddenAt     DateTime?
  hiddenBy     User?         @relation("CommentsHidden", fields: [hiddenById], references: [id])
  hiddenById   Int?
  hiddenReason ReportReason?
}

// Reacciones cannábicas: una por usuario por post o comentario (HU-RC-001)
enum ReactionType {
  LIKE
  ROLA
  INTERESA
  MOLESTA
}

model Reaction {
  id             Int           @id @default(autoincrement())
  type           ReactionType
  user           User          @relation(fields: [userId], references: [id])
  userId         Int
  post           Post?         @relation(fields: [postId], references: [id])
  postId         Int?
  comment        Comment?      @relation(fields: [commentId], references: [id])
  commentId      Int?
  forumPost      ForumPost?    @relation(fields: [forumPostId], references: [id])
  forumPostId    Int?
  forumComment   ForumComment? @relation(fields: [forumCommentId], references: [id])
  forumCommentId Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@unique([userId, forumPostId])
  @@unique([userId, forumCommentId])
}

model Chat {
  id        Int       @id @default(autoincrement())
  users     User[]    @relation("UserChats")
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    Int
  sender    User     @relation("UserMessages", fields: [senderId], references: [id])
  senderId  Int
  content   String
  createdAt DateTime @default(now())
}

// Foros estilo Reddit: subforos creados por la comunidad, posts con puntaje
// (reacciones: LIKE/ROLA/INTERESA = +1, MOLESTA = -1) e hilos anidados
model SubForum {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  description String?
  creator     User             @relation("UserSubforums", fields: [creatorId], references: [id])
  creatorId   Int
  posts       ForumPost[]
  followers   SubForumFollow[]
  notifications Notification[]
  reports     Report[]
  createdAt   DateTime         @default(now())
  // Archivar un subforo lo deja en solo lectura: no admite posts nuevos y
  // desaparece del directorio, pero su contenido sigue siendo consultable.
  archivedAt   DateTime?
  archivedBy   User?     @relation("SubforumsArchived", fields: [archivedById], references: [id])
  archivedById Int?
}

model SubForumFollow {
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  subforum   SubForum @relation(fields: [subforumId], references: [id])
  subforumId Int
  createdAt  DateTime @default(now())

  @@id([userId, subforumId])
}

model ForumPost {
  id            Int            @id @default(autoincrement())
  title         String
  content       String
  image         String?
  score         Int            @default(0)
  author        User           @relation(fields: [authorId], references: [id])
  authorId      Int
  subforum      SubForum       @relation(fields: [subforumId], references: [id])
  subforumId    Int
  comments      ForumComment[]
  reactions     Reaction[]
  notifications Notification[]
  reports       Report[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  hiddenAt     DateTime?
  hiddenBy     User?         @relation("ForumPostsHidden", fields: [hiddenById], references: [id])
  hiddenById   Int?
  hiddenReason ReportReason?

  @@index([subforumId, createdAt])
  @@index([subforumId, score])
  @@index([hiddenAt])
}

model ForumComment {
  id            Int            @id @default(autoincrement())
  content       String
  image         String?
  score         Int            @default(0)
  depth         Int            @default(0)
  deletedAt     DateTime?
  author        User           @relation(fields: [authorId], references: [id])
  authorId      Int
  post          ForumPost      @relation(fields: [postId], references: [id])
  postId        Int
  parent        ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  parentId      Int?
  replies       ForumComment[] @relation("CommentReplies")
  reactions     Reaction[]
  notifications Notification[]
  reports       Report[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  hiddenAt     DateTime?
  hiddenBy     User?         @relation("ForumCommentsHidden", fields: [hiddenById], references: [id])
  hiddenById   Int?
  hiddenReason ReportReason?

  @@index([postId, parentId])
}

// ---------- Moderación (HU-SEG-002 y HU-SEG-005) ----------

// Motivos tipificados: la lista es cerrada para que la cola sea filtrable y las
// notificaciones al autor digan siempre lo mismo ante el mismo motivo.
enum ReportReason {
  SPAM
  ACOSO
  ODIO
  ILEGAL
  DESINFORMACION
  SEXUAL
  SUPLANTACION
  OTRO
}

enum ReportStatus {
  PENDIENTE
  ACCIONADO
  DESCARTADO
}

enum ReportTargetType {
  POST
  COMMENT
  FORUM_POST
  FORUM_COMMENT
  USER
  SUBFORUM
}

// Un reporte apunta a UNA cosa. Se usan claves foráneas tipadas en vez de un id
// polimórfico suelto: así la base garantiza que el objeto existe y se puede
// traer el contenido en contexto con un include, sin consultas condicionales.
//
// El chat privado NO es reportable por decisión de producto: moderarlo obligaría
// a que alguien lea mensajes 1 a 1, y eso rompe la promesa de privacidad.
model Report {
  id             Int              @id @default(autoincrement())
  reporter       User             @relation("ReportsMade", fields: [reporterId], references: [id])
  reporterId     Int
  targetType     ReportTargetType
  reason         ReportReason
  detail         String?

  post           Post?            @relation(fields: [postId], references: [id])
  postId         Int?
  comment        Comment?         @relation(fields: [commentId], references: [id])
  commentId      Int?
  forumPost      ForumPost?       @relation(fields: [forumPostId], references: [id])
  forumPostId    Int?
  forumComment   ForumComment?    @relation(fields: [forumCommentId], references: [id])
  forumCommentId Int?
  targetUser     User?            @relation("ReportsAboutUser", fields: [targetUserId], references: [id])
  targetUserId   Int?
  subforum       SubForum?        @relation(fields: [subforumId], references: [id])
  subforumId     Int?

  status       ReportStatus @default(PENDIENTE)
  resolvedBy   User?        @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolvedById Int?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime     @default(now())

  // Un reporte por persona y objeto. Postgres trata los NULL como distintos,
  // así que cada restricción solo aplica a los reportes de ese tipo.
  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, forumPostId])
  @@unique([reporterId, forumCommentId])
  @@unique([reporterId, targetUserId])
  @@unique([reporterId, subforumId])
  @@index([status, createdAt])
}

enum ModerationActionType {
  OCULTAR
  MOSTRAR
  SUSPENDER
  LEVANTAR_SUSPENSION
  ARCHIVAR_SUBFORO
  RESTAURAR_SUBFORO
  RENOMBRAR_SUBFORO
  DESCARTAR_REPORTE
}

// Bitácora de lo que hace la moderación. Es lo que hace auditable al panel:
// toda acción queda registrada aunque después se revierta.
model ModerationAction {
  id          Int                  @id @default(autoincrement())
  moderator   User                 @relation("ModeratorActions", fields: [moderatorId], references: [id])
  moderatorId Int
  type        ModerationActionType
  targetType  ReportTargetType
  targetId    Int
  reason      ReportReason?
  note        String?
  createdAt   DateTime             @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Centro de notificaciones in-app
enum NotificationType {
  REPLY_POST
  REPLY_COMMENT
  NEW_SUBFORUM_POST
  POKE
  CONTENIDO_OCULTO
  CUENTA_SUSPENDIDA
}

model Notification {
  id             Int              @id @default(autoincrement())
  type           NotificationType
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id])
  recipientId    Int
  actor          User             @relation("NotificationActor", fields: [actorId], references: [id])
  actorId        Int
  subforum       SubForum?        @relation(fields: [subforumId], references: [id])
  subforumId     Int?
  forumPost      ForumPost?       @relation(fields: [forumPostId], references: [id])
  forumPostId    Int?
  forumComment   ForumComment?    @relation(fields: [forumCommentId], references: [id])
  forumCommentId Int?
  // Motivo, solo en las notificaciones de moderación: se avisa QUÉ se retiró y
  // POR QUÉ, nunca quién reportó ni qué moderador actuó.
  reason         ReportReason?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([recipientId, readAt])
}

model MarketItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  owner       User     @relation("UserMarketItems", fields: [ownerId], references: [id])
  ownerId     Int
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Privacidad: exportación y eliminación propia (HU-PRIV-001) ----------

enum PrivacyActionType {
  EXPORTAR_DATOS
  ELIMINAR_CUENTA
}

// Bitácora de las dos acciones de privacidad que puede hacer una persona
// sobre SÍ MISMA. Mismo criterio que ModerationAction: queda registrado que
// pasó, aunque para ese momento la cuenta ya esté anonimizada.
model PrivacyAction {
  id        Int               @id @default(autoincrement())
  user      User              @relation(fields: [userId], references: [id])
  userId    Int
  type      PrivacyActionType
  createdAt DateTime          @default(now())

  @@index([userId])
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  post      Post?    @relation(fields: [postId], references: [id])
  postId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  createdAt DateTime @default(now())
}