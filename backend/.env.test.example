# Entorno de PRUEBAS. Copiar a .env.test y completar.
#
# La suite BORRA datos: crea cuentas, posts y conversaciones de prueba y las
# elimina al terminar. Por eso nunca debe apuntar a la base de desarrollo.
#
# El runner (tests/run.js) se niega a arrancar si:
#   - falta .env.test
#   - la URL no lleva un ?schema= distinto de "public"
#   - la URL coincide con la de .env
#
# Opción A (la de este proyecto, sin infraestructura extra): mismo proyecto de
# Supabase, ESQUEMA aparte. Prisma crea ahí su propio juego de tablas; la app de
# desarrollo usa "public" y no las ve. Basta copiar las cadenas de .env y
# agregarles el parámetro schema.
#
# Opción B (aislamiento estricto): un segundo proyecto de Supabase, o un
# Postgres local. En ese caso pega aquí sus cadenas — el resto no cambia.

# Runtime: pooler en modo transacción (puerto 6543) + schema de pruebas
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=weedtown_test"
# Migraciones: conexión directa/sesión (puerto 5432) + mismo schema
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=weedtown_test"

# Secreto propio de pruebas: no reutilizar el de desarrollo
JWT_SECRET="secreto-solo-para-pruebas-cambiar"

# Puerto del backend que levanta el runner (distinto del 4000 de desarrollo,
# para poder correr las pruebas sin apagar lo que estés usando)
PORT=4010
BACKEND_URL="http://localhost:4010"
FRONTEND_URL="http://localhost:3000"
