# Entorno de pruebas contra un Postgres LOCAL en Docker (npm run test:local).
#
# `scripts/test-local.js` levanta el contenedor `weedtown-pg-test` en el puerto
# 55432 y copia este archivo a `.env.test.local` (ignorado por git) la primera
# vez. No hay nada que completar: el usuario y la contraseña son del contenedor
# efímero, que solo escucha en 127.0.0.1 y vive en memoria.
#
# Los guardias de tests/run.js se aplican igual: el schema no es "public" y la
# URL no es la de .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/weedtown_ci?schema=weedtown_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:55432/weedtown_ci?schema=weedtown_test"

JWT_SECRET="secreto-solo-para-pruebas-cambiar"

PORT=4010
BACKEND_URL="http://localhost:4010"
FRONTEND_URL="http://localhost:3000"

# Mismo valor que .env.test.example: la suite entera comparte un solo proceso.
API_LIMITER_MAX=5000
