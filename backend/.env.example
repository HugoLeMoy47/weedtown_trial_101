# ⚠️ LA BASE DE DESARROLLO NO DEBE SER LA DE PRODUCCIÓN
#
# Esto ya pasó (2026-08-08): el .env local apuntaba al mismo proyecto y al
# mismo schema que producción. La migración del ciclo 9C se aplicó sobre los
# datos reales de la comunidad al correr `prisma migrate dev` en una máquina.
# Esa vez fue aditiva y no rompió nada, pero `migrate dev` también OFRECE
# RESETEAR la base cuando detecta deriva: un enter de más habría borrado las
# cuentas, posteos, foros y chats de personas reales.
#
# Y aparte del riesgo: desarrollar contra producción significa leer chats
# privados y posteos "solo amigos" de gente real. En esta red eso no es solo
# un problema operativo.
#
# Usa un PROYECTO DE SUPABASE APARTE para desarrollo, no solo otro schema:
# con otro schema conservas las mismas credenciales, y el default cuando se te
# olvida el `?schema=` es `public` — o sea, producción.
#
# Para comprobar contra qué base estás trabajando, mira la línea
# `arranque_base_de_datos` al levantar el backend: dice host y schema.
#
# Supabase (Postgres gestionado)
# Runtime: pooler en modo transacción (puerto 6543). Copiar desde Supabase → Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones: conexión directa (puerto 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Secreto para firmar los JWT de sesión y el state de OAuth (usar un valor largo y aleatorio)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# URLs de la app (para el flujo OAuth de Mastodon).
# Para acceder también desde otras máquinas de tu red local, usa la IP LAN
# (ej. http://192.168.1.77:4000) y recuerda: si cambias BACKEND_URL hay que
# vaciar la tabla MastodonApp para que las apps OAuth se re-registren.
BACKEND_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
# Orígenes adicionales permitidos por CORS, separados por comas (opcional)
# ALLOWED_ORIGINS="http://localhost:3000,http://192.168.1.77:3000"

PORT=4000

# --- Almacenamiento de imágenes ---
# local     (default) → disco del proceso. Sirve para desarrollo.
# supabase            → Supabase Storage. USAR EN PRODUCCIÓN: en un PaaS con
#                       disco efímero (Render, Railway, Fly) las imágenes
#                       guardadas en local desaparecen al redesplegar.
STORAGE_DRIVER="local"

# Solo con STORAGE_DRIVER=supabase. La service key es secreta: nunca exponerla
# al frontend ni commitearla. El bucket debe existir y ser público de lectura.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_KEY="<service-role-key>"
# SUPABASE_BUCKET="weedtown-media"

# --- Enlace mágico por correo ---
# log      (default) → imprime el enlace en la consola del backend, no manda
#                       nada de verdad. Sirve para desarrollo y pruebas.
# resend              → Resend (https://resend.com) vía su API REST. USAR EN
#                       PRODUCCIÓN: requiere RESEND_API_KEY.
MAIL_DRIVER="log"

# Solo con MAIL_DRIVER=resend.
# RESEND_API_KEY="re_xxxxxxxx"
# Remitente. "onboarding@resend.dev" (el default) solo entrega a la cuenta
# dueña de la API key — sirve para probar. En producción hay que verificar un
# dominio propio en Resend y usar un remitente de ese dominio.
# RESEND_FROM="WeedTown <acceso@tudominio.mx>"

# --- Llaves de acceso (passkeys / WebAuthn) ---
# No llevan variable propia: se atan al dominio de FRONTEND_URL (su "RP ID").
# OJO: el spec de WebAuthn exige un dominio válido — no funciona sobre una IP
# de LAN (ej. http://192.168.1.77:3000), aunque el resto de la app sí. Para
# probar passkeys desde otra máquina de la red hace falta un dominio real
# (o un túnel tipo ngrok) apuntando al frontend; "localhost" sí funciona.

# --- Cuarentena de cuentas nuevas, diferenciada por método (HU-SEG-006/007) ---
# Antes de que la cuenta tenga esta antigüedad no puede mandar un toque de
# Cerca ni abrir una conversación de chat nueva — encarece re-contactar a
# alguien de inmediato con una cuenta recién creada tras una suspensión.
# Mastodon no tiene variable: su cuarentena es 0h porque ya paga un costo real
# de origen (una cuenta en una instancia del fediverso). Una cuenta con varias
# identidades toma la ventana MÁS CORTA de las que tenga — a propósito: llave +
# correo de respaldo debe bajar la espera, es la conducta que se quiere
# fomentar para recuperación de cuenta.
#
# Correo verificado: ya demuestra control de un buzón (lo comprobó el enlace
# mágico) — señal intermedia entre una llave anónima y Mastodon.
# SIGNUP_QUARANTINE_HOURS_EMAIL=3
#
# Ojo: el panóptico lee ESTAS DOS, no una tercera variable propia. Hasta el
# ciclo 12C leía SIGNUP_QUARANTINE_HOURS (sin sufijo), que nadie define desde
# HU-SEG-007 — caía siempre a 24 h y el tablero contaba de más.
#
# Solo llave de acceso: registro instantáneo y gratuito, sin ninguna señal —
# la ventana más larga.
# SIGNUP_QUARANTINE_HOURS_PASSKEY=24

# --- Límite general de la API (SOLO para pruebas) ---
# apiLimiter (app.js) es 300 peticiones/15min por IP — el presupuesto de una
# persona usuaria real. NO DEFINIR ESTA VARIABLE EN PRODUCCIÓN: existe
# únicamente porque la suite de integración corre contra un solo proceso del
# backend, y ese presupuesto termina siendo el de la SUITE completa, no el de
# una sesión. Solo backend/.env.test (pruebas locales) y el `env:` del job de
# backend en .github/workflows/ci.yml (pruebas en CI) la definen.
# API_LIMITER_MAX=5000

# --- Siembra de subforos institucionales (scripts/subforos.js) ---
# Handle de la cuenta a la que se le atribuyen los subforos del catálogo
# institucional. Default: "weedtown". Solo la lee el script; el backend no.
# La cuenta tiene que existir ya — el script no crea usuarios a propósito.
# SUBFORUM_SEED_CREATOR="weedtown"

# --- Entorno de ejecución ---
# El host (Render en producción) la define solo. Cámbiala aquí únicamente si
# quieres previsualizar en local el formato de logging de producción (morgan
# 'combined' en vez del 'dev' coloreado) — ver app.js.
# NODE_ENV="production"

# --- Panóptico: salida a observabilidad (HU-PAN-003) ---
# URL del panel externo de observabilidad (logs/errores/latencia en el
# tiempo — eso es infraestructura, no algo que este backend calcule o
# persista). Si no está definida, la tarjeta de estado técnico en /admin dice
# que no hay observabilidad conectada en vez de mostrar un enlace roto.
# OBSERVABILITY_URL="https://tu-servicio-de-observabilidad.com/weedtown"
